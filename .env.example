# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Staff portal session signing secret (override in production)
SESSION_SECRET="change-this-session-secret-in-production"

# Initial seeded staff admin credentials (change after first login)
ADMIN_SEED_EMAIL="principal@apostoliccarmel.ac.ke"
ADMIN_SEED_PASSWORD="CarmelHeights2026!"
